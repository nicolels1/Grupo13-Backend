      "id": "a8e45e18-e530-4d17-8c8b-02322242bedf",
      "name": "Para o botão de girar",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        -192
      ],
      "webhookId": "21e93164-152e-4018-bc59-660b9b3b0b7f",
      "credentials": {
        "telegramApi": {
          "id": "vF6T9gEvIO7bSYE5",
          "name": "Telegram account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// divide a resposta em partes, na ordem. Os marcadores que a IA escreve viram blocos montados aqui com os\n// dados do backend (a IA só escolhe; foto, preço, endereço, horário e links nunca são escritos por ela):\n//   [[peca:ID]]       cartão da peça, com foto e botões\n//   [[loja:ID]]       bloco da loja; lojas seguidas saem juntas, uma mensagem por marca\n//   [[escolher_marca]] botões Casa Lorenzi / Vulto / As duas\n//   [[lembrete]]      botões Sim / Não do e-mail antes de os pontos vencerem\n//   [[carrinho]]      botão que abre o carrinho (o link vem do link_carrinho, em carrinho)\n//   [[menu]]          botões do menu: Procurar uma peça, Lojas e horários, Meus pontos e Meus pedidos\n// O Telegram lê como HTML: escapa < > & para não quebrar o envio\nconst e = $('Entrada').first().json;\nconst resposta = String(e.resposta ?? '').trim()\n  || 'Desculpe, não consegui montar a resposta agora. Pode repetir?';\nconst porId = (lista, campo) => new Map((Array.isArray(lista) ? lista : []).map((x) => [String(x[campo]), x]));\nconst pecas = porId(e.pecas, 'id_produto');\nconst lojas = porId(e.lojas, 'id_unidade');\nconst carrinho = String(e.carrinho ?? '').trim() || null;\nconst html = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst MARCADOR_PECA = /\\[\\[peca:(\\d+)\\]\\]/g;\nconst MARCADOR_LOJA = /\\[\\[loja:(\\d+)\\]\\]/g;\nconst MARCADOR_MARCA = /\\[\\[escolher_marca\\]\\]/g;\nconst MARCADOR_LEMBRETE = /\\[\\[lembrete\\]\\]/g;\nconst MARCADOR_CARRINHO = /\\[\\[carrinho\\]\\]/g;\nconst MARCADOR_MENU = /\\[\\[menu\\]\\]/g;\nconst FOTO = /https?:\\/\\/\\S+?\\.(?:jpe?g|png|webp)(?:\\?\\S*)?(?=\\s|$)/i;\nconst MARCAS = { lorenzi: 'Casa Lorenzi', vulto: 'Vulto' };\nconst LIMITE = 4000; // o Telegram recusa mensagem com mais de 4096 caracteres\n\n// ---------- peça ----------\nconst EMOJIS = [\n  [/bolsa|ecobag|mochila|carteira|pochete/i, '👜'], [/calça|calca|bermuda|short/i, '👖'],\n  [/jaqueta|casaco|blazer|moletom|parka|bomber|corta.vento|colete/i, '🧥'], [/vestido|saia/i, '👗'],\n  [/tênis|tenis|sapato|sandália|sandalia|bota/i, '👟'], [/meia/i, '🧦'], [/boné|bone|chapéu|chapeu/i, '🧢'],\n];\nconst emoji = (nome) => (EMOJIS.find(([re]) => re.test(nome)) ?? [null, '👕'])[1];\nconst reais = (valor) => {\n  const [inteiro, centavos] = Number(valor).toFixed(2).split('.');\n  return `${inteiro.replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.')},${centavos}`;\n};\nconst cartao = (p) => [\n  `${emoji(p.nome)} <b>${html(p.nome)}</b>`,\n  `🏷️ ${MARCAS[p.marca] ?? html(p.marca)}`,\n  p.cores?.length ? `🎨 ${html(p.cores.join(', '))}` : null,\n  p.tamanhos_no_site?.length ? `📏 ${html(p.tamanhos_no_site.join(', '))}` : null,\n  `💰 A partir de R$ ${reais(p.preco_a_partir)}`,\n].filter(Boolean).join('\\n');\n\n// ---------- loja ----------\n// endereço ainda não cadastrado vem como \"A confirmar, s/n - Batel, Curitiba/PR\": mostra só bairro e cidade\nconst A_CONFIRMAR = /a confirmar/i;\nconst onde = (endereco) => {\n  const texto = String(endereco ?? '');\n  if (!A_CONFIRMAR.test(texto)) return { linha: texto, mapa: texto };\n  const depois = texto.split(' - ').pop();\n  return { linha: depois.split(', ').filter((p) => !A_CONFIRMAR.test(p)).join(', '), mapa: null };\n};\nconst blocoDaLoja = (l) => {\n  const local = onde(l.endereco);\n  const hoje = l.proximos_dias?.[0];\n  const horario = hoje\n    ? `🕙 Hoje: ${html(hoje.horario)}${hoje.motivo ? ` (${html(hoje.motivo)})` : ''}`\n    : `🕙 ${html(l.hoje?.texto ?? '')}`;\n  const mapa = local.mapa\n    ? `<a href=\"https://www.google.com/maps/search/?api=1&amp;query=${encodeURIComponent(local.mapa)}\">🗺️ Ver no mapa</a>`\n    : null;\n  return [\n    `📍 <b>${html(l.nome)}</b>`,\n    local.linha ? html(local.linha) : null,\n    horario,\n    hoje?.aviso ? `⚠️ ${html(hoje.aviso)}` : null,\n    mapa,\n  ].filter(Boolean).join('\\n');\n};\n\nconst partes = [];\nlet texto = [];\nlet carrinhoUsado = false;\nconst soltaTexto = (tipo = 'texto') => {\n  if (texto.length) partes.push({ tipo, texto_html: html(texto.join('\\n\\n')) });\n  texto = [];\n};\nfor (const bloco of resposta.split(/\\n\\s*\\n/).map((b) => b.trim()).filter(Boolean)) {\n  const achadas = [...bloco.matchAll(MARCADOR_PECA)].map((m) => pecas.get(m[1])).filter(Boolean);\n  const lojasDoBloco = [...bloco.matchAll(MARCADOR_LOJA)].map((m) => lojas.get(m[1])).filter(Boolean);\n  if (achadas.length || lojasDoBloco.length) {\n    // o texto da IA em volta dos marcadores fica antes dos blocos, menos a linha que é só o nome da loja (a IA às\n    // vezes lista \"Lorenzi Paulista [[loja:41]]\", e o nome já vem no bloco). Frase que cita a loja fica\n    const nomes = lojasDoBloco.map((l) => String(l.nome).toLowerCase());\n    const soNome = (linha) => {\n      const sem = linha.replace(/^[\\s\\-–•*\\d.)]+/u, '').replace(/^\\p{Extended_Pictographic}️?\\s*/u, '').toLowerCase();\n      return nomes.some((nome) => sem.startsWith(nome));\n    };\n    const fala = bloco.split('\\n')\n      .map((linha) => linha.replace(MARCADOR_PECA, '').replace(MARCADOR_LOJA, '').trim())\n      .filter((linha) => linha && !soNome(linha))\n      .join('\\n');\n    if (lojasDoBloco.length && fala) texto.push(fala);\n    soltaTexto();\n    for (const p of achadas) {\n      partes.push({\n        tipo: p.foto ? 'peca_com_foto' : 'peca_sem_foto',\n        foto: p.foto ?? null,\n        texto_html: cartao(p),\n        link: p.link,\n        // volta pelo Normalizador como se o cliente tivesse escrito (máximo de 64 bytes)\n        clique_estoque: `Tamanhos e estoque da peça ${p.id_produto}`,\n      });\n    }\n    for (const l of lojasDoBloco) partes.push({ tipo: 'loja', loja: l });\n    continue;\n  }\n  const pedeMarca = MARCADOR_MARCA.test(bloco);\n  const pedeLembrete = MARCADOR_LEMBRETE.test(bloco);\n  const pedeCarrinho = MARCADOR_CARRINHO.test(bloco);\n  const pedeMenu = MARCADOR_MENU.test(bloco);\n  // marcador de peça ou loja que a ferramenta não trouxe nesta resposta (a IA copiou da memória): some, e fica só o\n  // texto da IA; o bloco que era só marcador não sai\n  const limpo = bloco.replace(MARCADOR_MARCA, '').replace(MARCADOR_LEMBRETE, '').replace(MARCADOR_CARRINHO, '')\n    .replace(MARCADOR_MENU, '').replace(/\\[\\[[^\\]]*\\]\\]/g, '').replace(/[ \\t]+\\n/g, '\\n').trim();\n  const foto = limpo.match(FOTO);\n  if (foto) {\n    soltaTexto();\n    partes.push({ tipo: 'foto', foto: foto[0], texto_html: html(limpo.replace(foto[0], '').trim().slice(0, 1000)) });\n  } else if (pedeCarrinho && carrinho && !carrinhoUsado) {\n    // o botão vai na mensagem do próprio bloco; sem texto em volta, uma frase fixa\n    texto.push(limpo || 'Seu carrinho está pronto:');\n    soltaTexto('texto_com_carrinho');\n    carrinhoUsado = true;\n  } else if (pedeMenu) {\n    // o menu vai na mensagem do próprio bloco; o bloco que era só o marcador leva o texto de antes\n    if (limpo) texto.push(limpo);\n    if (!texto.length) texto.push('Como posso te ajudar?');\n    soltaTexto('texto_com_menu');\n  } else if (limpo) {\n    texto.push(limpo);\n    if (pedeMarca) soltaTexto('texto_com_marcas');\n    else if (pedeLembrete) soltaTexto('texto_com_lembrete');\n  }\n}\nsoltaTexto();\n// link gerado e a IA esqueceu o marcador: o botão vai depois da última mensagem de texto\n// (e antes da pergunta da avaliação, que sai da mensagem para continuar no fim)\nif (carrinho && !carrinhoUsado) {\n  const ultimaParte = partes[partes.length - 1];\n  const paragrafos = ultimaParte?.tipo === 'texto' ? ultimaParte.texto_html.split('\\n\\n') : [];\n  const pergunta = paragrafos.length && /Consegui te ajudar\\?/i.test(paragrafos[paragrafos.length - 1])\n    ? paragrafos.pop() : null;\n  if (pergunta && paragrafos.length) ultimaParte.texto_html = paragrafos.join('\\n\\n');\n  else if (pergunta) partes.pop();\n  partes.push({ tipo: 'texto_com_carrinho', texto_html: 'Seu carrinho está pronto:' });\n  if (pergunta) partes.push({ tipo: 'texto', texto_html: pergunta });\n}\n\n// lojas seguidas viram uma mensagem por marca, na ordem em que apareceram\nconst juntas = [];\nfor (const parte of partes) {\n  const anterior = juntas[juntas.length - 1];\n  if (parte.tipo === 'loja' && anterior?.tipo === 'grupo_de_lojas') anterior.lojas.push(parte.loja);\n  else juntas.push(parte.tipo === 'loja' ? { tipo: 'grupo_de_lojas', lojas: [parte.loja] } : parte);\n}\nconst finais = juntas.flatMap((parte) => {\n  if (parte.tipo !== 'grupo_de_lojas') return [parte];\n  const marcas = [...new Set(parte.lojas.map((l) => l.marca))];\n  return marcas.map((marca) => ({\n    tipo: 'texto',\n    texto_html: [`🏷️ <b>${MARCAS[marca] ?? html(marca)}</b>`, ...parte.lojas.filter((l) => l.marca === marca).map(blocoDaLoja)]\n      .join('\\n\\n'),\n  }));\n});\n\nconst ultima = finais[finais.length - 1];\nif (ultima?.tipo === 'texto') {\n  // boas-vindas: o menu de opções vai na última mensagem\n  if (e.menu === true) ultima.tipo = 'texto_com_menu';\n  // a pergunta de avaliação vai com os botões 👍/👎 (o clique volta como texto pelo Normalizador)\n  else if (/Consegui te ajudar\\?/i.test(ultima.texto_html)) ultima.tipo = 'texto_com_botoes';\n}\n\n// texto acima do limite do Telegram: corta entre parágrafos (ou no limite, num parágrafo enorme). Os botões\n// ficam no último pedaço\nconst pedacos = (t) => {\n  const saida = [];\n  let atual = '';\n  for (const paragrafo of t.split('\\n\\n')) {\n    for (let i = 0; i < paragrafo.length || i === 0; i += LIMITE) {\n      const trecho = paragrafo.slice(i, i + LIMITE);\n      if (atual && atual.length + 2 + trecho.length > LIMITE) {\n        saida.push(atual);\n        atual = trecho;\n      } else atual = atual ? `${atual}\\n\\n${trecho}` : trecho;\n    }\n  }\n  if (atual) saida.push(atual);\n  return saida;\n};\nconst cortadas = finais.flatMap((parte) => {\n  if (!parte.tipo.startsWith('texto') || (parte.texto_html ?? '').length <= LIMITE) return [parte];\n  const lista = pedacos(parte.texto_html);\n  return lista.map((t, i) => ({ ...parte, tipo: i === lista.length - 1 ? parte.tipo : 'texto', texto_html: t }));\n});\n\nreturn cortadas.map(({ loja, lojas: _, ...p }) => ({\n  json: {\n    canal: e.canal, id_externo: e.id_externo, foto: null, link: null, clique_estoque: null, ...p,\n    ...(p.tipo === 'texto_com_carrinho' ? { link: carrinho } : {}),\n  },\n}));\n"
      },
