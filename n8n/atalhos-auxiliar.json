      "parameters": {
        "jsCode": "// resposta do lembrete_pontos (botões Sim/Não), já como texto para o cliente. Sem conta no site, o detail\n// traz o link de cadastro; 401 é a confirmação que venceu (30 min parado)\nconst r = $json;\nif (r.ok) return { json: { resposta: r.dados.mensagem } };\nif (!r.status || r.status >= 500) {\n  return { json: { resposta: 'Estou com uma instabilidade agora e não consegui guardar sua escolha. Pode tentar de novo em alguns instantes?' } };\n}\nif (r.status === 401) {\n  return { json: { resposta: 'Para guardar o lembrete preciso confirmar que é você de novo. Me peça seus pontos que eu confirmo e te pergunto outra vez.' } };\n}\nreturn { json: { resposta: r.detail } };\n"
      },
