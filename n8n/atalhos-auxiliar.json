    {
      "parameters": {
        "jsCode": "// álbum do Telegram chega como uma mensagem por foto, em execuções separadas: cada uma se anota na tabela,\n// espera as outras e só a primeira anotada responde, para o cliente receber um aviso só\nconst linhas = $input.all().map((item) => item.json).filter((linha) => linha.id !== undefined);\nlinhas.sort((a, b) => Number(a.id) - Number(b.id));\nconst primeira = linhas[0];\nif (!primeira || String(primeira.execucao) === String($execution.id)) {\n  return [{ json: { resposta: `Mandei as fotos para a equipe no chamado #${$('Entrada').first().json.id_chamado} ✅` } }];\n}\nreturn [{ json: { silencio: true } }];\n"
      },
      "id": "c559b19e-da25-4c6a-a6cf-8b61536c0b32",
      "name": "Primeira do álbum?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3200,
        576
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "enviado",
              "name": "resposta",
              "type": "string",
              "value": "={{ ($('Entrada').first().json.arquivo_mime === 'application/pdf' ? 'Mandei o PDF' : 'Mandei a foto') + ' para a equipe no chamado #' + $('Entrada').first().json.id_chamado + ' ✅' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f714a9be-9bde-411d-ad8e-0d6a900577aa",
      "name": "Texto: anexo enviado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2480,
        768
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// download do Telegram ou envio ao backend que não deu certo: 422 traz o motivo pronto (tipo ou tamanho do\n// arquivo, chamado já concluído); o resto é instabilidade. O site continua aceitando o anexo\nconst id = $('Entrada').first().json.id_chamado;\nconst site = `https://lorenzi.vercel.app/loja/chamados/${id}`;\nconst status = Number($json.statusCode ?? 0);\nconst detail = typeof $json.body?.detail === 'string' ? $json.body.detail : null;\nconst motivo = status === 422 && detail\n  ? `Não consegui mandar o arquivo: ${detail}.`\n  : 'Não consegui mandar o arquivo para a equipe agora.';\nreturn { json: { resposta: `${motivo}\\n\\nSe quiser, anexe no chamado #${id} pelo site: ${site}` } };\n"
      },
      "id": "eddf4dcd-08d6-4794-8295-4a644697b1f6",
      "name": "Texto: anexo falhou",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        768
      ]
    },
    {
      "parameters": {
        "content": "## Mensagem sem texto\nCom chamado aberto, foto ou PDF de até 10 MB vai para o chamado como anexo. Equipe conversando (resposta há menos de 30 min): não responde. Álbum de fotos recebe um aviso só (tabela anexos_em_album). Áudio, vídeo e figurinha viram um aviso no chamado e o link do site. Sem chamado, pede texto. Erro sempre avisa o cliente.",
        "height": 912,
        "width": 3424,
        "color": "#E5B0B9"
      },
      "id": "37880fe6-d67e-4f18-b3c7-3edf050ae543",
      "name": "Nota: Mensagem sem texto",
