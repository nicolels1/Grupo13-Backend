            }
          ]
        }
      },
      "id": "de6af50b-2803-4ef2-823e-1a03f115ce7f",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// esperando o CPF ou o código: só os números da mensagem vão para o backend, sem passar pela IA.\n// Mensagem sem número (\"cancelar\", clique num botão do menu) é desistência: a conversa volta para a IA.\n// Poucos números no meio de uma frase (\"e o pedido 123?\") também não são CPF: a frase vai para a IA\nconst etapa = $('Entrada').first().json.etapa;\nconst texto = String($('Entrada').first().json.texto ?? '');\nconst numeros = texto.replace(/\\D/g, '');\n// tirando os números e palavras como \"meu cpf é\", sobra uma frase?\nconst SEM_SENTIDO = new Set(['meu', 'minha', 'cpf', 'código', 'codigo', 'número', 'numero', 'é', 'e', 'o', 'aqui', 'segue',\n  'ta', 'tá', 'está', 'esta', 'ok']);\nconst temFrase = (texto.toLowerCase().match(/[a-zà-ú]+/g) ?? []).some((palavra) => !SEM_SENTIDO.has(palavra));\n\nlet acao = 'desistiu';\nif (etapa === 'esperando_cpf' && numeros && (numeros.length >= 9 || !temFrase)) {\n  acao = numeros.length === 11 ? 'pedir_codigo' : 'cpf_incompleto';\n} else if (etapa === 'esperando_codigo' && numeros && (numeros.length >= 4 || !temFrase)) {\n  acao = 'conferir_codigo';\n}\n\nreturn {\n  json: {\n    acao,\n    cpf: acao === 'pedir_codigo' ? numeros : '',\n    codigo: acao === 'conferir_codigo' ? numeros.slice(0, 10) : '',\n  },\n};\n"
      },
