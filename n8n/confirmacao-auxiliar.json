    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// resposta do pedir_codigo ou do conferir_codigo, já como texto para o cliente.\n// Erro de regra (CPF inválido, código errado ou expirado, confirmação pausada) vem pronto no detail\nconst r = $json;\n// a dica vai para todo mundo, com ou sem cadastro: dizer só a quem não tem e-mail revelaria que o CPF existe.\n// Ao criar a conta com o mesmo CPF, o histórico do cliente sem conta da Vulto passa para ela (ADR 0016)\nconst SEM_CODIGO = 'Não chegou em alguns minutos? Confira o spam. Se você ainda não tem conta no site, ou seu cadastro antigo '\n  + 'da Vulto não tem e-mail, crie sua conta em https://lorenzi.vercel.app/cadastro com o mesmo CPF: seus pontos e '\n  + 'pedidos aparecem nela, e aí consigo te mostrar por aqui.';\nif (!r.ok) {\n  const instavel = !r.status || r.status >= 500;\n  return {\n    json: {\n      resposta: instavel\n        ? 'Estou com uma instabilidade agora e não consegui confirmar. Pode tentar de novo em alguns instantes?'\n        : r.detail,\n    },\n  };\n}\nif (r.operacao === 'pedir_codigo') {\n  return {\n    json: {\n      resposta: `${r.dados.mensagem}\\n\\nQuando chegar, me manda o código aqui.\\n\\n${SEM_CODIGO}\\n\\nSe preferir deixar para depois, é só escrever cancelar.`,\n    },\n  };\n}\n// confirmado: o cliente continua o que pedia (pontos, pedidos ou o chamado) ou escolhe no menu\nconst nome = r.dados?.nome;\nreturn { json: { resposta: `Pronto${nome ? `, ${nome}` : ''}! Confirmei que é você 😊 Pode continuar de onde parou, ou escolha uma opção:`, menu: true } };\n"
      },
