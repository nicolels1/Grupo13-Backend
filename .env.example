# URL do projeto Supabase (Project Settings > API > Project URL)
# Formato: https://<project-ref>.supabase.co (sem barra no final)
SUPABASE_URL=

# Conexões com o PostgreSQL do Supabase (botão "Connect" no painel do projeto).
# Copie a URL do painel e troque [YOUR-PASSWORD] pela senha do banco.
# Se a senha tiver caracteres especiais (@, #, /, %...), ela precisa estar codificada (ex.: @ vira %40).

# Usada pela API (FastAPI): Transaction pooler, porta 6543
# postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Usada pelas migrations (Alembic): Direct connection, porta 5432
# postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
# Se a sua rede não tiver IPv6 e a conexão falhar, use o Session pooler (mesma URL do pooler, porta 5432)
DATABASE_URL_DIRECT=

# Sites (frontends) que podem chamar a API pelo navegador, separados por vírgula, sem barra no final.
# Sem a variável, só o frontend local do Vite (http://localhost:5173) é liberado.
# Ex.: https://<seu-projeto>.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Opcional: expressão regular para liberar vários endereços de uma vez, como os previews da Vercel
# Ex.: https://<seu-projeto>-.*\.vercel\.app
CORS_ORIGIN_REGEX=
