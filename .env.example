# URL do projeto Supabase (Project Settings > API > Project URL)
# Formato: https://<project-ref>.supabase.co (sem barra no final)
SUPABASE_URL=

# Chave service_role do Supabase (Project Settings > API Keys > service_role / secret).
# Dá acesso total ao projeto: fica só no backend, nunca no frontend nem no git.
# Usada para criar logins (cadastro pelo backend, ADR 0008, e scripts/criar_admin.py).
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública do Supabase (Project Settings > API Keys > Publishable key).
# Usada no login por CPF: o backend troca CPF e senha pela sessão do Supabase.
SUPABASE_PUBLISHABLE_KEY=

# Conexões com o PostgreSQL do Supabase (botão "Connect" no painel do projeto).
# Copie a URL do painel e troque [YOUR-PASSWORD] pela senha do banco.
# Se a senha tiver caracteres especiais (@, #, /, %...), ela precisa estar codificada (ex.: @ vira %40).

# Usada pela API (FastAPI): Transaction pooler, porta 6543, com o usuário restrito da API
# (criado pela migration 56799f788354; a senha é definida no Supabase: veja o topo da migration)
# postgresql://api_casalorenzi.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Usada pelas migrations (Alembic): Direct connection, porta 5432, com o dono do banco (postgres)
# postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
# Se a sua rede não tiver IPv6 e a conexão falhar, use o Session pooler (mesma URL do pooler, porta 5432)
DATABASE_URL_DIRECT=

# Sites (frontends) que podem chamar a API pelo navegador, separados por vírgula, sem barra no final.
# Sem a variável, só o frontend local do Vite (http://localhost:5173) é liberado.
# Ex.: https://<seu-projeto>.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Opcional: expressão regular para liberar vários endereços de uma vez, como os previews da Vercel
# Ex.: https://<seu-projeto>-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Endereço da plataforma do cliente, sem barra no final: base dos links que o assistente manda.
# Sem a variável, usa o frontend local (http://localhost:5173).
# Ex.: https://<seu-projeto>.vercel.app
SITE_URL=

# Chave das rotas /assistente, chamadas pelo n8n no cabeçalho X-Assistente-Chave.
# Uma senha longa e aleatória; a mesma vai na credencial Header Auth do n8n. Sem ela, as rotas respondem 503.
ASSISTENTE_CHAVE=

# Chave da API do Brevo (Brevo > SMTP & API > API Keys), para o código que o assistente manda por e-mail.
# Sem ela, o código não sai e o cliente não consegue se confirmar; o erro aparece no log.
BREVO_API_KEY=
# Opcional: remetente dos e-mails, já verificado no Brevo. Sem a variável, casa.lorenzi.contato@gmail.com
EMAIL_REMETENTE=

# Token do bot do Telegram (o mesmo da credencial do n8n, dado pelo @BotFather). A resposta da equipe num
# chamado aberto pelo assistente sai por ele. Sem o token, a resposta fica só no chamado; o erro aparece no log.
TELEGRAM_BOT_TOKEN=

# Gmail dos clientes de teste do assistente (scripts/carregar_clientes_assistente.py): os clientes usam
# <caixa>+ana@gmail.com etc., que chegam nesta caixa. Nunca o e-mail da empresa. Não vai para o Render.
ASSISTENTE_CAIXA_TESTE=

# Opcional: senha das contas de demonstração criadas por scripts/carregar_demo.py.
# Sem a variável, o script pede a senha na hora. Não vai para o Render.
DEMO_SENHA=

# Opcional: pasta data/ do vulto-legado-back, lida pela migração da Vulto (migracao_vulto/).
# Clone o vulto-legado-back ao lado deste repositório, na pasta vulto-backend. Sem a variável, informe --origem no comando.
# Não vai para o Render.
# Ex.: ../vulto-backend/data
VULTO_DATA_DIR=
